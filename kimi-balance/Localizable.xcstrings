    "settings.step_3_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After signing in, choose “Login Completed, View Usage”. Your login is reused while its cookie remains valid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后选择“登录完成，查看用量”。只要 Cookie 仍然有效，应用就会复用登录状态。"
          }
        }
      }
    },

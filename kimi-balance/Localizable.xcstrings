    "settings.step_4_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The menu bar shows total and 5-hour usage. Open its menu to see reset times and more details."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏会显示总使用量和 5 小时用量。打开菜单可查看重置时间及更多详情。"

        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "30 秒" } }
      }
    },
    "settings.step_1_description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The app appears in the macOS menu bar. It does not open the main window automatically." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用会显示在 macOS 菜单栏中，不会自动打开主窗口。" } }
      }
    },
    "settings.step_1_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Launch Kimi Balance" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动 Kimi Balance" } }
      }
    },
    "settings.step_2_description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the menu bar menu and choose “Show Main Window”, then sign in on the kimi.com page." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开菜单栏菜单并选择“显示主窗口”，然后在 kimi.com 页面中登录。" } }
      }
    },
    "settings.step_2_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to Kimi" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录 Kimi" } }
      }
    },
    "settings.step_3_description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After signing in, choose “Login Completed, View Usage”. Your login is reused while its cookie remains valid." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录后选择“登录完成，查看用量”。只要 Cookie 仍然有效，应用就会复用登录状态。" } }
      }
    },
    "settings.step_3_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Load your usage" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加载用量" } }
      }
    },
    "settings.step_4_description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The menu bar shows total and 5-hour usage. Open its menu to see reset times and more details." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单栏会显示总使用量和 5 小时用量。打开菜单可查看重置时间及更多详情。" } }
      }
    },
    "settings.step_4_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check your subscription" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看订阅" } }
      }
    },
    "settings.step_5_description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Usage refreshes every 60 seconds by default. Choose “Refresh Now” for an immediate update. Closing the main window does not stop background refreshes." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用量默认每 60 秒刷新一次。选择“立即刷新”可立即更新。关闭主窗口不会停止后台刷新。" } }
      }
    },
    "settings.step_5_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh when needed" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按需刷新" } }

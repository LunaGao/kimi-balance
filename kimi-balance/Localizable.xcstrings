    "settings.step_2_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the menu bar menu and choose “Show Main Window”, then sign in on the kimi.com page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

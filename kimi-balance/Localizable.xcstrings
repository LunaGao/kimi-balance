    "settings.step_5_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage refreshes every 60 seconds by default. Choose “Refresh Now” for an immediate update. Closing the main window does not stop background refreshes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用量默认每 60 秒刷新一次。选择“立即刷新”可立即更新。关闭主窗口不会停止后台刷新。"
          }
        }
      }
    },
    "settings.step_5_title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refresh when needed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按需刷新"
          }
        }
